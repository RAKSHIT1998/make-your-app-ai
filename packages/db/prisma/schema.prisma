// Make Your App AI — core schema
// Every tenant-owned table carries organizationId (directly or via project) for isolation + RLS.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Identity & tenancy ─────────────────────────

enum PlatformRole {
  user
  support
  admin
  superadmin
}

enum OrgRole {
  owner
  admin
  member
  viewer
}

enum AccountStatus {
  active
  suspended
  deleted
}

model User {
  id           String        @id @db.Uuid // = Supabase auth.users.id
  email        String        @unique
  displayName  String?
  avatarUrl    String?
  platformRole PlatformRole  @default(user)
  status       AccountStatus @default(active)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  lastSeenAt   DateTime?
  /// Public creator handle (/c/:handle). Null until the user publishes or picks one.
  handle       String?       @unique
  bio          String        @default("")
  /// Shareable referral code (/r/:code). Generated lazily.
  referralCode String?       @unique

  memberships     OrganizationMembership[]
  likes           ProjectLike[]
  reports         ProjectReport[]
  referralsMade   Referral[]               @relation("Referrer")
  referredBy      Referral?                @relation("Referred")
  projectsCreated Project[]                @relation("ProjectCreator")
  auditLogs       AuditLog[]
  notifications   Notification[]
  supportRequests SupportRequest[]
  approvals       ApprovalRequest[]        @relation("ApprovalDecider")
  comments        ProjectComment[]
  commentReports  CommentReport[]
  following       UserFollow[]             @relation("Follower")
  followers       UserFollow[]             @relation("Followed")
  showcaseCollections ShowcaseCollection[]
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  personal  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships       OrganizationMembership[]
  projects          Project[]
  subscription      Subscription?
  creditLedger      CreditLedgerEntry[]
  aiUsage           AiUsage[]
  integrations      Integration[]
  developerAccounts DeveloperAccount[]
  domains           Domain[]
  auditLogs         AuditLog[]
  stores            Store[]
  entitlement       SubscriptionEntitlement?
  billingCheckouts  BillingCheckout[]
  invoices          Invoice[]
  invitations       OrganizationInvitation[]
  ideaValidations   IdeaValidation[]
}

model OrganizationMembership {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  role           OrgRole      @default(member)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

/// Pending invitation to join a workspace. The link token is shown once at creation; only its hash is stored.
model OrganizationInvitation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  /// Lower-cased. Only the signed-in user with this email can accept.
  email          String
  role           OrgRole
  tokenHash      String       @unique
  invitedById    String       @db.Uuid
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([expiresAt])
}

/// A saved AI assessment of a product idea. The report is the model's judgement from general knowledge, not market data.
model IdeaValidation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  idea           String
  report         Json
  creditsCharged Int
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// ───────────────────────── Billing ─────────────────────────

enum SubscriptionStatus {
  incomplete
  trialing
  active
  past_due
  halted
  canceled
  expired
}

enum PaymentProvider {
  stripe
  razorpay
}

enum BillingInterval {
  monthly
  yearly
}

/// Subscription plans are data (SubscriptionPlan in the spec). Owners edit them in the admin console — never in code.
model Plan {
  id                  String                    @id @default(uuid()) @db.Uuid
  code                String                    @unique // free | creator | pro | studio | ...
  name                String
  description         String                    @default("")
  sortOrder           Int                       @default(0)
  /// Monthly AI credit allowance (resets each billing period; unused allowance expires).
  includedCredits     Int
  /// Maximum active (non-archived) projects.
  maxProjects         Int
  maxOrgs             Int                       @default(1)
  maxSeats            Int                       @default(1)
  dailyCreditLimit    Int?
  maxCreditsPerRun    Int                       @default(500)
  monthlyBuildCredits Int                       @default(0)
  /// Feature flags, e.g. website_generation, full_stack, mobile_builds, hosting, advanced_integrations, team_workspace.
  featureFlags        String[]
  /// Project types this plan may generate.
  projectTypes        String[]
  features            Json                      @default("{}")
  active              Boolean                   @default(true)
  public              Boolean                   @default(true)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  prices              PlanPrice[]
  subscriptions       Subscription[]
  entitlements        SubscriptionEntitlement[]
}

model PlanPrice {
  id             String          @id @default(uuid()) @db.Uuid
  planId         String          @db.Uuid
  interval       BillingInterval
  currency       String
  amountMinor    Int
  active         Boolean         @default(true)
  /// Provider-side plan/price ids. Razorpay plans are created on demand; Stripe prices must be created in Stripe and pasted here.
  razorpayPlanId String?         @unique
  stripePriceId  String?         @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  plan           Plan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  subscriptions  Subscription[]

  @@unique([planId, interval, currency])
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  organizationId         String             @unique @db.Uuid
  planId                 String             @db.Uuid
  priceId                String?            @db.Uuid
  status                 SubscriptionStatus @default(incomplete)
  provider               PaymentProvider?
  providerSubscriptionId String?            @unique
  providerCustomerId     String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?
  endedAt                DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                   Plan               @relation(fields: [planId], references: [id])
  price                  PlanPrice?         @relation(fields: [priceId], references: [id])
  invoices               Invoice[]
}

/// Effective entitlements for an organization, written ONLY by verified billing events (or the free-plan default).
model SubscriptionEntitlement {
  id                  String       @id @default(uuid()) @db.Uuid
  organizationId      String       @unique @db.Uuid
  planId              String       @db.Uuid
  source              String // free | subscription | admin
  monthlyCredits      Int
  maxActiveProjects   Int
  dailyCreditLimit    Int?
  maxCreditsPerRun    Int
  monthlyBuildCredits Int
  teamSeats           Int
  featureFlags        String[]
  projectTypes        String[]
  periodStart         DateTime
  periodEnd           DateTime?
  updatedAt           DateTime     @updatedAt
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                Plan         @relation(fields: [planId], references: [id])
}

enum CheckoutKind {
  subscription
  topup
}

enum CheckoutStatus {
  created
  completed
  expired
  failed
}

/// A checkout we started with a payment provider. Completing it requires a verified server-side event.
model BillingCheckout {
  id                     String          @id @default(uuid()) @db.Uuid
  organizationId         String          @db.Uuid
  createdById            String          @db.Uuid
  kind                   CheckoutKind
  provider               PaymentProvider
  providerRef            String          @unique
  /// Stripe: the subscription created by a completed Checkout Session (linked via webhook).
  providerSubscriptionId String?         @unique
  planPriceId            String?         @db.Uuid
  creditPackId           String?         @db.Uuid
  amountMinor            Int
  currency               String
  status                 CheckoutStatus  @default(created)
  clientParams           Json            @default("{}")
  createdAt              DateTime        @default(now())
  completedAt            DateTime?
  organization           Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model CreditPack {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  credits    Int
  priceMinor Int
  currency   String   @default("INR")
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum InvoiceStatus {
  paid
  partially_refunded
  refunded
  void
}

/// Platform billing invoices (what customers pay Make Your App AI). Created only from verified payments.
model Invoice {
  id                String          @id @default(uuid()) @db.Uuid
  organizationId    String          @db.Uuid
  number            String          @unique
  subscriptionId    String?         @db.Uuid
  checkoutId        String?         @db.Uuid
  description       String
  currency          String
  totalMinor        Int
  /// Tax included in totalMinor (prices are tax-inclusive).
  taxMinor          Int             @default(0)
  /// Payment processor fee, when the provider reports it.
  feeMinor          Int?
  refundedMinor     Int             @default(0)
  status            InvoiceStatus   @default(paid)
  provider          PaymentProvider
  providerPaymentId String          @unique
  periodStart       DateTime?
  periodEnd         DateTime?
  paidAt            DateTime
  createdAt         DateTime        @default(now())
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription      Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([organizationId, paidAt])
}

enum LedgerReason {
  plan_grant
  purchase
  ai_usage
  infra_usage
  refund
  adjustment
  expiry
  referral
}

enum CreditBucket {
  allowance
  purchased
}

/// Append-only. Balance = SUM(amount). Writes happen inside transactions with an idempotency key.
model CreditLedgerEntry {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  amount         Int // + grant, − spend (credits, integer)
  reason         LedgerReason
  /// allowance = monthly plan credits (expire at period end); purchased = top-ups (never expire).
  bucket         CreditBucket @default(allowance)
  idempotencyKey String       @unique
  referenceType  String? // e.g. "ai_usage", "invoice"
  referenceId    String?
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, bucket])
}

// ───────────────────────── Projects ─────────────────────────

enum ProjectType {
  mobile_app
  website
  ecommerce
  business_website
  saas
  custom_software
  game
}

enum ProjectStatus {
  draft
  generating
  ready
  error
  archived
}

model Project {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  createdById    String        @db.Uuid
  name           String
  description    String        @default("")
  type           ProjectType
  status         ProjectStatus @default(draft)
  templateId     String? // versioned template key e.g. "nextjs-site@1"
  spec           Json? // latest ProductSpec
  designSpec     Json?
  gitRepoPath    String? // storage key of the project's git repo
  headVersionId  String?       @unique @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  // ── Showcase (public pages, Explore, remix) ──
  visibility         ProjectVisibility @default(private)
  /// Public URL slug (/p/:slug), assigned on first publish and kept stable.
  slug               String?           @unique
  /// The version visitors and remixers get. Later private edits are never exposed until republished.
  publishedVersionId String?           @db.Uuid
  publishedAt        DateTime?
  /// What the public page shows (pages, palette, file count), frozen at publish time.
  publishedSnapshot  Json?
  publicTitle        String?
  publicDescription  String?
  category           String?
  allowRemix         Boolean           @default(true)
  /// Visitors may comment on the public page. Owners can turn this off.
  commentsEnabled    Boolean           @default(true)
  /// "Made with Make Your App AI". Only paid plans may turn it off (enforced server-side).
  showAttribution    Boolean           @default(true)
  featuredAt         DateTime?
  /// Set when a moderator unpublishes the project; blocks republishing until cleared.
  moderatedAt        DateTime?
  moderationNote     String?
  remixedFromId      String?           @db.Uuid
  /// Set when the project was started from an approved template.
  fromTemplateId     String?           @db.Uuid
  likeCount          Int               @default(0)
  viewCount          Int               @default(0)
  remixCount         Int               @default(0)

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User                @relation("ProjectCreator", fields: [createdById], references: [id])
  remixedFrom    Project?            @relation("Remixes", fields: [remixedFromId], references: [id], onDelete: SetNull)
  remixes        Project[]           @relation("Remixes")
  likes          ProjectLike[]
  appBackend     AppBackend?
  appUsers       AppUser[]
  appRecords     AppRecord[]
  comments       ProjectComment[]
  showcaseCollectionItems ShowcaseCollectionItem[]
  hostingSite    HostingSite?
  template       Template?           @relation("TemplateSource")
  envVars        ProjectEnvVar[]
  viewDays       ProjectViewDay[]
  reports        ProjectReport[]
  headVersion    ProjectVersion?     @relation("ProjectHead", fields: [headVersionId], references: [id])
  versions       ProjectVersion[]    @relation("ProjectVersions")
  files          ProjectFile[]
  generationRuns GenerationRun[]
  buildJobs      BuildJob[]
  deployments    HostingDeployment[]
  publishing     PublishingRecord[]
  approvals      ApprovalRequest[]
  store          Store?

  @@index([organizationId, deletedAt])

  @@index([visibility, publishedAt])
  @@index([remixedFromId])
}

/// Index of files at head (content lives in git; small text files are cached here for fast reads).
model ProjectFile {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  path      String
  sha256    String
  sizeBytes Int
  content   String? // cached when < 256 KB
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
}

model ProjectVersion {
  id              String         @id @default(uuid()) @db.Uuid
  projectId       String         @db.Uuid
  number          Int
  commitSha       String
  message         String
  generationRunId String?        @unique @db.Uuid
  createdAt       DateTime       @default(now())
  project         Project        @relation("ProjectVersions", fields: [projectId], references: [id], onDelete: Cascade)
  headOf          Project?       @relation("ProjectHead")
  generationRun   GenerationRun? @relation(fields: [generationRunId], references: [id])

  @@unique([projectId, number])
}

// ───────────────────────── AI engine ─────────────────────────

enum RunStatus {
  queued
  running
  awaiting_approval
  succeeded
  failed
  canceled
}

enum RunKind {
  create
  edit
  repair
  plan
  ask
}

model GenerationRun {
  id          String          @id @default(uuid()) @db.Uuid
  projectId   String          @db.Uuid
  requestedBy String          @db.Uuid
  kind        RunKind
  prompt      String
  status      RunStatus       @default(queued)
  error       String?
  creditsUsed Int             @default(0)
  /// Credits returned because the run failed through no fault of the customer (see GenerationsService.refundFailedRun).
  creditsRefunded Int         @default(0)
  /// kind=ask: the assistant's answer (no code is changed).
  answer      String?
  /// kind=plan: the drafted plan (spec, questions, assumptions). kind=create from a plan: the plan run it built.
  plan        Json?
  fromPlanId  String?         @db.Uuid
  startedAt   DateTime?
  finishedAt  DateTime?
  /// Which API instance is executing the run, and when it last proved it is alive. A run whose lease lapses is failed by any instance.
  workerId    String?
  heartbeatAt DateTime?
  createdAt   DateTime        @default(now())
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       AgentTask[]
  events      AgentEvent[]
  version     ProjectVersion?
  aiUsage     AiUsage[]

  @@index([projectId, createdAt])
}

enum AgentName {
  architect
  designer
  frontend
  backend
  qa
  release
}

model AgentTask {
  id              String        @id @default(uuid()) @db.Uuid
  generationRunId String        @db.Uuid
  agent           AgentName
  status          RunStatus     @default(queued)
  attempt         Int           @default(1)
  input           Json
  output          Json?
  error           String?
  startedAt       DateTime?
  finishedAt      DateTime?
  run             GenerationRun @relation(fields: [generationRunId], references: [id], onDelete: Cascade)

  @@index([generationRunId])
}

model AgentEvent {
  id              BigInt        @id @default(autoincrement())
  generationRunId String        @db.Uuid
  agent           AgentName?
  type            String // step.started | step.completed | file.changed | check.failed | log ...
  message         String
  data            Json          @default("{}")
  createdAt       DateTime      @default(now())
  run             GenerationRun @relation(fields: [generationRunId], references: [id], onDelete: Cascade)

  @@index([generationRunId, id])
}

model AiProviderConfig {
  id                      String   @id @default(uuid()) @db.Uuid
  provider                String // anthropic | openai | gemini | ...
  model                   String
  tier                    String // fast | balanced | deep
  enabled                 Boolean  @default(true)
  priority                Int      @default(100) // lower = preferred
  inputCostPerMTokMicros  Int // USD micros per million input tokens
  outputCostPerMTokMicros Int
  capabilities            Json     @default("{}") // { structuredOutput: true, tools: true, maxOutput: 32000 }
  /// 0-100. A tier only routes to models at or above its minimum quality.
  quality                 Int      @default(100)
  /// Provider free-tier / spend caps per UTC day; the router stops using a route that reaches them.
  dailyRequestLimit       Int?
  dailyTokenLimit         Int?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([provider, model])
}

/// What customers are charged per million tokens for each tier, whichever model serves the request.
model AiTierRate {
  tier                    String   @id // fast | balanced | deep
  inputCostPerMTokMicros  Int
  outputCostPerMTokMicros Int
  updatedAt               DateTime @updatedAt
}

model AiUsage {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @db.Uuid
  generationRunId String?        @db.Uuid
  provider        String
  model           String
  agent           AgentName?
  inputTokens     Int
  outputTokens    Int
  costMicros      BigInt // USD micros — infra cost to us
  creditsCharged  Int // what the customer was charged
  latencyMs       Int
  success         Boolean
  createdAt       DateTime       @default(now())
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  run             GenerationRun? @relation(fields: [generationRunId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([provider, model, createdAt])
}

// ───────────────────────── Builds, hosting, publishing ─────────────────────────

enum BuildTarget {
  web
  ios
  android
}

model BuildJob {
  id         String          @id @default(uuid()) @db.Uuid
  projectId  String          @db.Uuid
  versionId  String?         @db.Uuid
  target     BuildTarget
  profile    String          @default("preview") // development | preview | production
  status     RunStatus       @default(queued)
  provider   String // sandbox | eas
  externalId String?
  logsKey    String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime        @default(now())
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  artifacts  BuildArtifact[]
}

model BuildArtifact {
  id         String   @id @default(uuid()) @db.Uuid
  buildJobId String   @db.Uuid
  kind       String // ipa | apk | aab | web-bundle
  storageKey String
  sizeBytes  BigInt
  sha256     String
  createdAt  DateTime @default(now())
  buildJob   BuildJob @relation(fields: [buildJobId], references: [id], onDelete: Cascade)
}

enum DomainStatus {
  pending_verification
  verified
  active
  error
}

model Domain {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  projectId      String?      @db.Uuid
  hostname       String       @unique
  status         DomainStatus @default(pending_verification)
  sslStatus      String       @default("pending")
  dnsRecords     Json         @default("[]")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum DeploymentStatus {
  queued
  building
  deployed_unverified
  live
  failed
  rolled_back
}

model HostingDeployment {
  id          String           @id @default(uuid()) @db.Uuid
  projectId   String           @db.Uuid
  versionId   String           @db.Uuid
  provider    String // vercel | cloudflare
  externalId  String?
  url         String?
  status      DeploymentStatus @default(queued)
  healthCheck Json? // last health-check result — "live" requires a passing check
  approvedBy  String?          @db.Uuid
  createdAt   DateTime         @default(now())
  /// deploy | rollback (a rollback redeploys an earlier version's exact files as a new deployment)
  kind          String         @default("deploy")
  versionNumber Int            @default(0)
  error         String?
  createdById   String?        @db.Uuid
  readyAt       DateTime?
  lastSyncedAt  DateTime?
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

/// One hosted site per project at the provider (created on first deploy).
model HostingSite {
  projectId         String   @id @db.Uuid
  provider          String
  siteName          String   @unique
  externalProjectId String
  productionUrl     String?
  liveDeploymentId  String?  @db.Uuid
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// Customer-defined environment variables. Values are AES-256-GCM encrypted and never returned to browsers.
model ProjectEnvVar {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @db.Uuid
  key            String
  encryptedValue String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
}

model Integration {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  provider       String // stripe | razorpay | resend | ...
  status         String       @default("disconnected") // disconnected | connected | error
  scopes         String[]
  credentialRef  String? // reference to encrypted secret (never plaintext)
  encryptedCreds String? // AES-256-GCM payload
  lastTestedAt   DateTime?
  lastTestResult Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
}

model DeveloperAccount {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  platform       String // apple | google_play | expo
  displayName    String
  encryptedCreds String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model PublishingRecord {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @db.Uuid
  platform   String // app_store | google_play | web
  status     String // prepared | submitted_by_customer | ...
  metadata   Json     @default("{}")
  approvedBy String?  @db.Uuid
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

enum ApprovalAction {
  publish
  domain_change
  payment_activation
  destructive_change
  paid_upgrade
}

enum ApprovalStatus {
  pending
  approved
  rejected
  expired
}

model ApprovalRequest {
  id          String         @id @default(uuid()) @db.Uuid
  projectId   String         @db.Uuid
  action      ApprovalAction
  status      ApprovalStatus @default(pending)
  summary     String
  payload     Json
  decidedById String?        @db.Uuid
  decidedAt   DateTime?
  expiresAt   DateTime
  createdAt   DateTime       @default(now())
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  decidedBy   User?          @relation("ApprovalDecider", fields: [decidedById], references: [id])
}

// ───────────────────────── Ops ─────────────────────────

model AuditLog {
  id             BigInt        @id @default(autoincrement())
  organizationId String?       @db.Uuid
  actorId        String?       @db.Uuid
  action         String // project.created, auth.login, admin.user.suspended ...
  targetType     String?
  targetId       String?
  ip             String?
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor          User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      String
  title     String
  body      String
  data      Json      @default("{}")
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model SupportRequest {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  subject   String
  body      String
  status    String   @default("open")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Commerce (multi-tenant) ─────────────────────────
// Every generated store runs on this shared engine. All money is integer minor units (paise/cents).

enum StoreStatus {
  draft
  active
  paused
}

model Store {
  id               String                  @id @default(uuid()) @db.Uuid
  organizationId   String                  @db.Uuid
  projectId        String?                 @unique @db.Uuid
  name             String
  slug             String                  @unique
  currency         String                  @default("INR")
  status           StoreStatus             @default(draft)
  contactEmail     String?
  theme            Json                    @default("{}")
  /// Basis points, e.g. 1800 = 18%.
  taxRateBps       Int                     @default(0)
  pricesIncludeTax Boolean                 @default(true)
  paymentProvider  PaymentProvider?
  /// Delivery extension in use (e.g. "shiprocket"). Credentials live encrypted in Integration.
  shippingProvider String?
  /// Non-secret delivery settings: pickup location name, pickup postcode, default parcel size.
  shippingSettings Json                    @default("{}")
  nextOrderNumber  Int                     @default(1001)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  deletedAt        DateTime?
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project          Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)
  products         Product[]
  collections      Collection[]
  customers        Customer[]
  orders           Order[]
  discounts        Discount[]
  shippingConfigs  ShippingConfiguration[]
  shipments        Shipment[]

  @@index([organizationId])
}

enum ProductStatus {
  draft
  active
  archived
}

model Product {
  id          String              @id @default(uuid()) @db.Uuid
  storeId     String              @db.Uuid
  title       String
  handle      String
  description String              @default("")
  status      ProductStatus       @default(draft)
  digital     Boolean             @default(false)
  images      Json                @default("[]")
  tags        String[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?
  store       Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variants    ProductVariant[]
  collections ProductCollection[]

  @@unique([storeId, handle])
  @@index([storeId, status])
}

model Collection {
  id          String              @id @default(uuid()) @db.Uuid
  storeId     String              @db.Uuid
  title       String
  handle      String
  description String              @default("")
  createdAt   DateTime            @default(now())
  store       Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products    ProductCollection[]

  @@unique([storeId, handle])
}

model ProductCollection {
  productId    String     @db.Uuid
  collectionId String     @db.Uuid
  position     Int        @default(0)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

model ProductVariant {
  id             String      @id @default(uuid()) @db.Uuid
  productId      String      @db.Uuid
  storeId        String      @db.Uuid
  title          String
  sku            String?
  priceMinor     Int
  compareAtMinor Int?
  options        Json        @default("{}")
  weightGrams    Int?
  position       Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory      Inventory?
  orderItems     OrderItem[]

  @@unique([storeId, sku])
  @@index([productId])
}

/// available = onHand - reserved. Reservations are taken at checkout and converted (or released) on payment.
model Inventory {
  id                String         @id @default(uuid()) @db.Uuid
  variantId         String         @unique @db.Uuid
  storeId           String         @db.Uuid
  tracked           Boolean        @default(true)
  onHand            Int            @default(0)
  reserved          Int            @default(0)
  lowStockThreshold Int            @default(5)
  updatedAt         DateTime       @updatedAt
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model Customer {
  id               String   @id @default(uuid()) @db.Uuid
  storeId          String   @db.Uuid
  email            String
  name             String?
  phone            String?
  acceptsMarketing Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders           Order[]

  @@unique([storeId, email])
}

enum OrderStatus {
  pending_payment
  paid
  partially_refunded
  refunded
  cancelled
  expired
}

enum FulfillmentStatus {
  unfulfilled
  fulfilled
  returned
}

model Order {
  id                   String            @id @default(uuid()) @db.Uuid
  storeId              String            @db.Uuid
  number               Int
  customerId           String?           @db.Uuid
  email                String
  status               OrderStatus       @default(pending_payment)
  fulfillmentStatus    FulfillmentStatus @default(unfulfilled)
  currency             String
  subtotalMinor        Int
  discountMinor        Int               @default(0)
  shippingMinor        Int               @default(0)
  taxMinor             Int               @default(0)
  totalMinor           Int
  refundedMinor        Int               @default(0)
  discountCode         String?
  shippingMethod       String?
  shippingAddress      Json              @default("{}")
  /// Client-supplied idempotency key: retrying checkout with the same token returns the same order.
  checkoutToken        String            @unique
  /// Secret given to the buyer; required (with the order id) to view the order without a merchant login.
  accessToken          String            @unique
  reservationExpiresAt DateTime
  paidAt               DateTime?
  cancelledAt          DateTime?
  fulfilledAt          DateTime?
  trackingNumber       String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  store                Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer             Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items                OrderItem[]
  payments             Payment[]
  refunds              Refund[]
  shipment             Shipment?

  @@unique([storeId, number])
  @@index([storeId, status, createdAt])
  @@index([status, reservationExpiresAt])
}

model OrderItem {
  id             String         @id @default(uuid()) @db.Uuid
  orderId        String         @db.Uuid
  variantId      String         @db.Uuid
  productTitle   String
  variantTitle   String
  sku            String?
  unitPriceMinor Int
  quantity       Int
  totalMinor     Int
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant        ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
}

enum PaymentStatus {
  created
  succeeded
  failed
}

model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  orderId           String          @db.Uuid
  storeId           String          @db.Uuid
  provider          PaymentProvider
  providerOrderId   String          @unique
  providerPaymentId String?         @unique
  amountMinor       Int
  currency          String
  status            PaymentStatus   @default(created)
  /// Public parameters the storefront needs to complete payment (never secrets). Re-served on idempotent checkout retries.
  clientParams      Json            @default("{}")
  failureReason     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds           Refund[]

  @@index([storeId])
}

enum RefundStatus {
  pending
  succeeded
  failed
}

model Refund {
  id               String       @id @default(uuid()) @db.Uuid
  orderId          String       @db.Uuid
  paymentId        String       @db.Uuid
  amountMinor      Int
  reason           String       @default("")
  status           RefundStatus @default(pending)
  providerRefundId String?      @unique
  idempotencyKey   String       @unique
  restock          Boolean      @default(false)
  createdById      String       @db.Uuid
  createdAt        DateTime     @default(now())
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment          Payment      @relation(fields: [paymentId], references: [id])
}

enum DiscountType {
  percentage
  fixed_amount
  free_shipping
}

model Discount {
  id               String       @id @default(uuid()) @db.Uuid
  storeId          String       @db.Uuid
  code             String
  type             DiscountType
  /// percentage: basis points (1000 = 10%); fixed_amount: minor units; free_shipping: ignored.
  value            Int          @default(0)
  minSubtotalMinor Int          @default(0)
  startsAt         DateTime?
  endsAt           DateTime?
  usageLimit       Int?
  usageCount       Int          @default(0)
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now())
  store            Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, code])
}

/// A parcel booked with a delivery extension. One per order; each booking step is recorded so a failed step can be resumed.
model Shipment {
  id                 String    @id @default(uuid()) @db.Uuid
  storeId            String    @db.Uuid
  orderId            String    @unique @db.Uuid
  provider           String
  /// created | awb_assigned | pickup_scheduled | in_transit | out_for_delivery | delivered | returned | cancelled | exception
  state              String    @default("created")
  providerStatus     String?
  providerOrderId    String
  providerShipmentId String
  awb                String?
  courierName        String?
  pickupScheduledFor String?
  trackingUrl        String?
  estimatedDelivery  String?
  events             Json      @default("[]")
  /// Why the last booking step failed, shown to the merchant (never contains credentials).
  lastError          String?
  parcel             Json      @default("{}")
  /// Bumped when a cancelled shipment is booked again, so the provider sees a fresh reference.
  attempt            Int       @default(1)
  lastSyncedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  store              Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([storeId, state])
}

model ShippingConfiguration {
  id            String   @id @default(uuid()) @db.Uuid
  storeId       String   @db.Uuid
  name          String
  rateMinor     Int
  freeOverMinor Int?
  countries     String[]
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

/// Every verified provider webhook is recorded once; duplicates are acknowledged and skipped.
model PaymentWebhookEvent {
  id          String          @id @default(uuid()) @db.Uuid
  provider    PaymentProvider
  eventId     String
  type        String
  storeId     String?         @db.Uuid
  receivedAt  DateTime        @default(now())
  processedAt DateTime?
  outcome     String?

  @@unique([provider, eventId])
}


// ───────────────────────── Growth: showcase, referrals ─────────────────────────

enum ProjectVisibility {
  private
  public
}

model ProjectLike {
  projectId String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([projectId, createdAt])
}

/// One row per (project, viewer, day): views are counted once per viewer per day.
model ProjectViewDay {
  projectId String   @db.Uuid
  /// sha256 of user id, or of ip + user agent for anonymous visitors. Never stored raw.
  viewerKey String
  day       DateTime @db.Date
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, viewerKey, day])
  @@index([projectId, day])
}

enum ReportStatus {
  open
  dismissed
  actioned
}

model ProjectReport {
  id         String       @id @default(uuid()) @db.Uuid
  projectId  String       @db.Uuid
  reporterId String       @db.Uuid
  reason     String
  details    String       @default("")
  status     ReportStatus @default(open)
  resolvedAt DateTime?
  createdAt  DateTime     @default(now())
  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([projectId, reporterId])
  @@index([status, createdAt])
}

enum CommentStatus {
  visible
  /// Hidden automatically after several reports, pending a moderator.
  hidden
  removed
}

model ProjectComment {
  id            String           @id @default(uuid()) @db.Uuid
  projectId     String           @db.Uuid
  authorId      String           @db.Uuid
  /// One level of replies: the parent is always a top-level comment.
  parentId      String?          @db.Uuid
  body          String
  status        CommentStatus    @default(visible)
  removedReason String?
  createdAt     DateTime         @default(now())
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author        User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent        ProjectComment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       ProjectComment[] @relation("Replies")
  reports       CommentReport[]

  @@index([projectId, createdAt])
  @@index([status, createdAt])
  @@index([authorId, createdAt])
}

model CommentReport {
  commentId  String         @db.Uuid
  reporterId String         @db.Uuid
  reason     String
  createdAt  DateTime       @default(now())
  resolvedAt DateTime?
  comment    ProjectComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporter   User           @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@id([commentId, reporterId])
}

model UserFollow {
  followerId String   @db.Uuid
  followedId String   @db.Uuid
  createdAt  DateTime @default(now())
  follower   User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followed   User     @relation("Followed", fields: [followedId], references: [id], onDelete: Cascade)

  @@id([followerId, followedId])
  @@index([followedId])
}

/// A creator-curated list of public projects (distinct from storefront product collections).
model ShowcaseCollection {
  id          String                   @id @default(uuid()) @db.Uuid
  ownerId     String                   @db.Uuid
  name        String
  description String                   @default("")
  isPublic    Boolean                  @default(false)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  owner       User                     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items       ShowcaseCollectionItem[]

  @@index([ownerId, updatedAt])
}

model ShowcaseCollectionItem {
  collectionId String             @db.Uuid
  projectId    String             @db.Uuid
  addedAt      DateTime           @default(now())
  collection   ShowcaseCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([collectionId, projectId])
  @@index([projectId])
}

enum ReferralStatus {
  pending
  rewarded
  rejected
}

/// A referred user is linked to exactly one referrer. Rewards are paid only after the
/// referred user's first verified payment (server-side webhook), never on signup.
model Referral {
  id             String         @id @default(uuid()) @db.Uuid
  referrerId     String         @db.Uuid
  referredUserId String         @unique @db.Uuid
  status         ReferralStatus @default(pending)
  rejectReason   String?
  invoiceId      String?        @db.Uuid
  referrerCredits Int           @default(0)
  referredCredits Int           @default(0)
  qualifiedAt    DateTime?
  createdAt      DateTime       @default(now())
  referrer       User           @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred       User           @relation("Referred", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([referrerId, createdAt])
}

/// Platform-wide growth settings (single row, id = "default"), editable in the owner console.
model GrowthSettings {
  id                       String   @id @default("default")
  referralsEnabled         Boolean  @default(true)
  referrerRewardCredits    Int      @default(300)
  referredRewardCredits    Int      @default(150)
  /// Max rewarded referrals per referrer per calendar month (anti-abuse).
  maxRewardsPerMonth       Int      @default(10)
  /// A code can only be claimed within this many days of the referred user's signup.
  claimWindowDays          Int      @default(7)
  updatedAt                DateTime @updatedAt
}

/// Platform-wide feature switches (kill switches and staged rollouts), managed in the owner console.
/// Plan-level entitlements stay on Plan.featureFlags; these gate a feature for everyone.
model PlatformFlag {
  key         String   @id
  enabled     Boolean  @default(true)
  description String   @default("")
  updatedAt   DateTime @updatedAt
  updatedBy   String?  @db.Uuid
}

enum TemplateStatus {
  pending
  approved
  rejected
  withdrawn
}

/// A published project offered as a starting point. Only approved templates are listed;
/// the files are frozen at submission (versionId) so later edits never leak into the template.
model Template {
  id          String         @id @default(uuid()) @db.Uuid
  projectId   String         @unique @db.Uuid
  versionId   String         @db.Uuid
  creatorId   String         @db.Uuid
  slug        String         @unique
  title       String
  description String         @default("")
  category    String?
  type        ProjectType
  status      TemplateStatus @default(pending)
  reviewNote  String?
  reviewedBy  String?        @db.Uuid
  reviewedAt  DateTime?
  /// Paid templates need creator payouts (not built yet); every template is free today.
  priceMinor  Int            @default(0)
  usesCount   Int            @default(0)
  featuredAt  DateTime?
  snapshot    Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  project     Project        @relation("TemplateSource", fields: [projectId], references: [id], onDelete: Cascade)

  @@index([status, usesCount])
}

/// Shared request counters for rate limiting across API instances (RATE_LIMIT_STORE=postgres). Expired rows are swept.
model RateLimitHit {
  key       String   @id
  hits      Int
  expiresAt DateTime

  @@index([expiresAt])
}

/// Built-in backend of a generated full-stack app. Data lives in two separate environments: "preview" (the builder's
/// workspace preview, reached with the secret previewKey) and "live" (the published app, reached by project id).
model AppBackend {
  projectId   String   @id @db.Uuid
  previewKey  String   @unique
  /// Owner controls for the live app: new end-user sign-ups, and a pause switch that takes the live app's data offline.
  signupsOpen Boolean  @default(true)
  paused      Boolean  @default(false)
  createdAt   DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// An end user of a generated app (not a platform user). Passwords are scrypt hashes.
model AppUser {
  id           String       @id @default(uuid()) @db.Uuid
  projectId    String       @db.Uuid
  env          String
  email        String
  passwordHash String
  lastSignInAt DateTime?
  createdAt    DateTime     @default(now())
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sessions     AppSession[]
  records      AppRecord[]

  @@unique([projectId, env, email])
}

model AppSession {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  appUserId String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      AppUser  @relation(fields: [appUserId], references: [id], onDelete: Cascade)

  @@index([appUserId])
}

model AppRecord {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @db.Uuid
  env        String
  collection String
  ownerId    String?  @db.Uuid
  data       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner      AppUser? @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([projectId, env, collection, createdAt])
  @@index([ownerId])
}
