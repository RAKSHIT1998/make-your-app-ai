{
  "name": "make-your-app-ai",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @mya/db generate",
    "db:migrate": "pnpm --filter @mya/db migrate:dev",
    "db:deploy": "pnpm --filter @mya/db migrate:deploy",
    "test:integration": "SANDBOX_INTEGRATION=1 turbo run test --filter=@mya/agents --filter=@mya/sandbox",
    "typecheck:mobile": "pnpm --filter @mya/mobile typecheck"
  },
  "devDependencies": {
    "turbo": "2.11.11",
    "typescript": "6.0.3",
    "@types/node": "22.20.5"
  }
}
