# ── Database (Supabase: Project Settings → Database) ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mya        # pooled (6543 on Supabase)
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/mya          # direct, used for migrations

# ── Supabase Auth ──
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Only needed for legacy HS256 projects; asymmetric-key projects are verified via JWKS
SUPABASE_JWT_SECRET=

# ── AI ──
ANTHROPIC_API_KEY=

# ── Platform ──
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
ENCRYPTION_KEY=   # openssl rand -base64 32
REDIS_URL=redis://localhost:6379

# ── Clients ──
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
EXPO_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
