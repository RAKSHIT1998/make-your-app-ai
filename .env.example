# Make Your App AI — environment variables.
# Copy to .env and fill in. NEVER commit real values. Values marked [prod] are required when NODE_ENV=production
# (the API refuses to start without them and names the missing key — it never prints values).

# ── Runtime ──
NODE_ENV=development
API_PORT=4000
# Reverse-proxy hops in front of the API (1 behind Render/Fly/most load balancers) so rate limits see real client IPs.
TRUST_PROXY=0

# ── Database (Supabase: Project Settings → Database) ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mya        # pooled connection (port 6543 on Supabase)
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/mya          # direct connection, used for migrations

# ── Auth (Supabase: Project Settings → API) ──
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Only for legacy HS256 projects; projects with asymmetric keys are verified via JWKS.
SUPABASE_JWT_SECRET=
# Comma-separated emails promoted to platform owner on sign-in.
PLATFORM_OWNER_EMAILS=

# ── Public URLs [prod: https, not localhost] ──
WEB_ORIGIN=http://localhost:3000          # allowed browser origins (comma-separated)
WEB_APP_URL=http://localhost:3000         # where customers return after checkout
PUBLIC_API_URL=http://localhost:4000      # shown to merchants as their webhook base

# ── Secrets ──
# [prod] 32 bytes, base64: openssl rand -base64 32 — losing it makes stored credentials unreadable. Back it up.
ENCRYPTION_KEY=

# ── AI ──
ANTHROPIC_API_KEY=
CREDITS_PER_USD=100           # 1 credit = $0.01 of model cost
MAX_CREDITS_PER_RUN=500
FREE_PLAN_CREDITS=100

# ── Project storage & sandbox ──
STORAGE_DIR=./.data/projects  # [prod] absolute path on a persistent disk, e.g. /data/projects
SANDBOX_PROVIDER=none         # docker (needs a Docker host) | none (static checks only) | local (dev only)
SANDBOX_DOCKER_IMAGE=node:22-bookworm-slim
SANDBOX_DOCKER_INSTALL_NETWORK=mya-registry-egress

# ── Platform billing (customers paying you) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=      # Razorpay → Webhooks → https://API/api/v1/webhooks/billing/razorpay
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=        # Stripe → Webhooks → https://API/api/v1/webhooks/billing/stripe
REPORTING_USD_INR=            # optional, margin reports only

# ── Hosting (Cloud Studio) ──
HOSTING_PROVIDER=none         # vercel in production; fake only for local development
VERCEL_TOKEN=
VERCEL_TEAM_ID=
MAX_DEPLOYMENTS_PER_DAY=30
DEPLOY_RATE_LIMIT_PER_MINUTE=10
BILLING_RATE_LIMIT_PER_MINUTE=10

# ── Abuse controls ──
RATE_LIMIT_PER_MINUTE=300
GENERATION_RATE_LIMIT_PER_MINUTE=20
CHECKOUT_RATE_LIMIT_PER_MINUTE=15
CHECKOUT_RESERVATION_MINUTES=30

# ── Operations ──
RECOVER_INTERRUPTED_RUNS=true # fail runs whose instance died (lease expired); safe with several instances
RUN_LEASE_SECONDS=60
RATE_LIMIT_STORE=memory # postgres = limits shared across API instances
SHUTDOWN_GRACE_SECONDS=25

# ── Web (Next.js; NEXT_PUBLIC_* values are public and baked in at build time) ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
API_INTERNAL_URL=             # optional: private API URL for server-side rendering
# Legal entity shown on Terms/Privacy (pages show "draft" until these are set)
NEXT_PUBLIC_LEGAL_COMPANY=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_EMAIL=
NEXT_PUBLIC_LEGAL_GRIEVANCE_OFFICER=
NEXT_PUBLIC_LEGAL_JURISDICTION=       # e.g. Jammu
NEXT_PUBLIC_LEGAL_REFUND_DAYS=        # refund window you offer, e.g. 7

# ── Mobile (Expo) ──
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
